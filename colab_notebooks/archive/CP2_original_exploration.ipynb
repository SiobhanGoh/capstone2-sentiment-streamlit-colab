    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "def apply_pretty_style():\n",
    "    plt.rcParams.update({\n",
    "        \"axes.facecolor\": \"#ffffff\",\n",
    "        \"figure.facecolor\": \"#ffffff\",\n",
    "        \"axes.edgecolor\": \"#dcdcdc\",\n",
    "        \"axes.grid\": True,\n",
    "        \"grid.color\": \"#e3e3e3\",\n",
    "        \"grid.linewidth\": 0.8,\n",
