    "pretty_block(\n",
    "    \"16.3 Creating README Model Card\",\n",
    "    \"This README will appear automatically on Hugging Face.\"\n",
    ")\n",
    "\n",
    "MODEL_CARD = (\n",
    "    \"# 🌸 Malay–English COVID-19 Sentiment Classifier (mBERT)\\n\\n\"\n",
