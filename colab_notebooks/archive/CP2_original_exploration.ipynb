    "    </div>\n",
    "    \"\"\"\n",
    "    display(HTML(html))\n",
    "\n",
    "apply_pretty_style()\n",
    "\n",
    "pretty_block(\n",
    "    \"PHASE 2 — Dataset Loading & Initial Structure\",\n",
    "    \"Introducing the cleaned tweet dataset before preprocessing.\"\n",
    ")\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 🌼 Dataset Path\n",
    "# ------------------------------------------------------------\n",
    "DATA_PATH = \"/content/drive/My Drive/Colab Notebooks/cleaned_tweets_sentiments.csv\"\n",
    "TEXT_COLUMN = \"Tweet\"\n",
