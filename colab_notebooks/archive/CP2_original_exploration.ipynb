    "probs_test = predict_proba_mbert(X_test.tolist())\n",
    "pred_ids = np.argmax(probs_test, axis=1)\n",
    "pred_labels = [id_to_label[i] for i in pred_ids]\n",
    "\n",
    "df_errors = pd.DataFrame({\n",
    "    \"Tweet\": X_test.tolist(),\n",
    "    \"True\": y_test.tolist(),\n",
    "    \"Predicted\": pred_labels,\n",
