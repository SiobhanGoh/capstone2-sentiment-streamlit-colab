    "# ============================================================\n",
    "# 🌸 PHASE 16 — Export + ZIP for Manual Hugging Face Upload\n",
    "# ============================================================\n",
    "\n",
    "from IPython.display import HTML, display\n",
    "import os, shutil\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# 🌼 Aesthetic Styling\n",
    "# ------------------------------------------------------------\n",
    "custom_css = \"\"\"\n",
